let lang = 'ro';
let selectedRole = null;

function setLang(l) {
  lang = l;
  document.getElementById('lang-screen').style.display = 'none';
  document.getElementById('form-screen').style.display = 'block';
  applyTranslations();
}

function goBack() {
  document.getElementById('form-screen').style.display = 'none';
  document.getElementById('lang-screen').style.display = 'flex';
}

function applyTranslations() {
  const t = T[lang];
  document.querySelectorAll('[data-t]').forEach(el => {
    const key = el.getAttribute('data-t');
    if (t[key]) el.textContent = t[key];
  });
  document.querySelectorAll('[data-ph]').forEach(el => {
    const key = el.getAttribute('data-ph');
    if (t[key]) el.placeholder = t[key];
  });
  document.querySelectorAll('[data-t-opt]').forEach(el => {
    const key = el.getAttribute('data-t-opt');
    if (t[key]) el.textContent = t[key];
  });
}

function selectRole(el) {
  document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  selectedRole = el.dataset.role;
  updateCondBlocks();
}

function updateCondBlocks() {
  const blocks = ['heroic','mythic','pvp','mplus','all'];
  blocks.forEach(b => document.getElementById('block-'+b).classList.remove('visible'));
  if (selectedRole && selectedRole !== 'casual') {
    const el = document.getElementById('block-'+selectedRole);
    if (el) el.classList.add('visible');
  }
}

async function submitApp() {
  const name = document.getElementById('char-name').value.trim();
  if (!name || !selectedRole) {
    alert(T[lang].alertMsg);
    return;
  }

  const btn = document.querySelector('.submit-btn');
  btn.textContent = '...';
  btn.disabled = true;

  const data = {
    language: lang,
    character_name: name,
    server: document.getElementById('char-server').value,
    class: document.getElementById('char-class').value,
    item_level: document.getElementById('char-ilvl').value,
    spec: document.getElementById('char-spec').value,
    role: document.getElementById('char-role').value,
    player_type: selectedRole,
    exp_heroic: document.getElementById('exp-heroic').value,
    heroic_lead: document.getElementById('heroic-lead').value,
    exp_mythic: document.getElementById('exp-mythic').value,
    logs_link: document.getElementById('logs-link').value,
    mythic_schedule: document.getElementById('mythic-sched').value,
    pvp_format: document.getElementById('pvp-format').value,
    pvp_rating: document.getElementById('pvp-rating').value,
    mplus_score: document.getElementById('mplus-score').value,
    mplus_role: document.getElementById('mplus-role').value,
    exp_all: document.getElementById('exp-all').value,
    motivation: document.getElementById('motivation').value,
    contact: document.getElementById('btag').value,
  };

  try {
    const res = await fetch('https://formspree.io/f/mgodwegj', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) {
      document.getElementById('form-screen').style.display = 'none';
      document.getElementById('success-screen').style.display = 'block';
      applyTranslations();
    } else {
      btn.textContent = T[lang].submitBtn;
      btn.disabled = false;
      alert('Eroare la trimitere. Încearcă din nou.');
    }
  } catch(e) {
    btn.textContent = T[lang].submitBtn;
    btn.disabled = false;
    alert('Eroare la trimitere. Verifică conexiunea.');
  }
}
